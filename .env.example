# ============================================================================
# HISIEM SOC Copilot — .env.example (SAFE PLACEHOLDERS ONLY)
# ----------------------------------------------------------------------------
# Copy to `.env.local` (gitignored) for local development and evaluation runs.
# Never put real secrets in this file or in `.env.example`.
# ============================================================================

# --- Copilot domain persistence (copilot schema — Alembic-owned) ------------
# Local-dev port contract: 5433 is Copilot's PostgreSQL (5432 is HISIEM's).
COPILOT_DATABASE_URL=postgresql+psycopg://copilot:copilot@127.0.0.1:5433/copilot

# --- LangGraph checkpoint persistence (langgraph_checkpoint — LangGraph-owned)
# The options=-csearch_path parameter pins the checkpointer to its own schema.
LANGGRAPH_DATABASE_URL=postgresql+psycopg://copilot:copilot@127.0.0.1:5433/copilot?options=-csearch_path%3Dlanggraph_checkpoint
LANGGRAPH_SCHEMA=langgraph_checkpoint

# --- HISIEM platform read access (runtime Bearer token injected by up-agent) --
HISIEM_BASE_URL=http://127.0.0.1:8080
# Runtime-only: set by scripts/dev/up-agent.ps1 into the child process env.
# Never commit a real token here.
HISIEM_BEARER_TOKEN=
HISIEM_TIMEOUT_SECONDS=10.0

# --- HISIEM dev auth bootstrap (LOCAL DEV ONLY — see scripts/dev auth helper) -
# HISIEM_DEV_USERNAME and HISIEM_DEV_PASSWORD are the dev admin credentials the
# auth helper uses to obtain a runtime Bearer token via the official HTTP login.
# HISIEM_BOOTSTRAP_PASSWORD is only needed on a genuinely first-run control-api
# (empty user store) to complete the one-time password rotation. All three live
# in `.env.local`, never committed.
HISIEM_DEV_USERNAME=
HISIEM_DEV_PASSWORD=
HISIEM_BOOTSTRAP_PASSWORD=
HISIEM_TENANT_ID=default

# --- LLM provider: "scripted" (default, offline) or "openai_compatible" -------
# The API key is read from the environment variable named by LLM_API_KEY_ENV —
# never from a config default or .env.example. Provide CMD_API_KEY in the
# environment (e.g. .env.local) when using the real provider.
LLM_PROVIDER=scripted
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY_ENV=CMD_API_KEY
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_ZDR=true
LLM_STRUCTURED_OUTPUT_MODE=auto

# --- Agent autonomy budget ---------------------------------------------------
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_TOOL_CALLS_PER_STEP=4
AGENT_MAX_LLM_CALLS=20
AGENT_MAX_LLM_TOKENS=20000
AGENT_MAX_DURATION_SECONDS=600

# --- API transport -----------------------------------------------------------
COPILOT_APP_API_HOST=0.0.0.0
COPILOT_APP_API_PORT=8000

# --- Trusted-context provider -------------------------------------------------
# "none" (default) fails closed — no request can be trusted.
# "header" is a DEVELOPMENT/TEST adapter only (X-Tenant-ID / X-Actor-Subject).
# "hisiem_bearer" is the integrated/production boundary: HISIEM is authenticated
#   with a shared server-only bearer credential BEFORE its tenant/actor is trusted.
# Production MUST use "hisiem_bearer" (or another real authenticator), never "header".
COPILOT_AUTH_TRUSTED_CONTEXT_PROVIDER=none
# NAME of the environment variable holding the HISIEM→Copilot service credential.
# The VALUE is never stored here: a blank/missing value fails closed at startup.
COPILOT_AUTH_HISIEM_SERVICE_TOKEN_ENV=HISIEM_COPILOT_SERVICE_TOKEN

# --- Durable workers ----------------------------------------------------------
# Disabled by default so unit tests never start a rogue background worker.
# Enable in an integrated deployment: graph dispatch + approved-response execution.
COPILOT_APP_ENABLE_DISPATCHER=false
COPILOT_APP_ENABLE_RESPONSE_WORKER=false

# --- HISIEM SOAR execution boundary (Copilot → HISIEM, server-to-server) -------
# The bearer is a server-only secret read from the environment; the adapter fails
# closed (never builds) when SOAR_BEARER_TOKEN is blank. Never commit a real value.
SOAR_BASE_URL=http://127.0.0.1:8080
SOAR_BEARER_TOKEN=
SOAR_TIMEOUT_SECONDS=10.0

# --- P3-A knowledge foundation + hybrid retrieval -----------------------------
# pgvector is an INFRASTRUCTURE prerequisite, not a Python package. It must be
# installed once in the Copilot database before `alembic upgrade head`:
#     CREATE EXTENSION IF NOT EXISTS vector SCHEMA copilot;
# If it already exists in `public`, one of these makes the `vector` type reachable
# from the search_path-pinned Copilot connection:
#     ALTER EXTENSION vector SET SCHEMA copilot;
# See docs/p3/p3-a-operations.md — no volume drop and no DB reset is required.

# Ingestion/retrieval bounds. Every one is a REJECTION threshold, never a
# truncation budget: an oversized document is refused, not silently shortened.
KNOWLEDGE_MAX_DOCUMENT_BYTES=2000000
KNOWLEDGE_MAX_NORMALIZED_CHARS=2000000
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=512
KNOWLEDGE_MAX_CHUNK_CHARS=8000

# FROZEN chunker profile. Changing these without bumping `chunker_version` would
# silently rewrite the retrieval projection of unchanged content. max <= 800.
KNOWLEDGE_CHUNK_TARGET_TOKENS=600
KNOWLEDGE_CHUNK_MAX_TOKENS=800
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=80

# Frozen retrieval profile `hybrid-v1`. Changing these changes every ranking.
KNOWLEDGE_LEXICAL_CANDIDATE_LIMIT=20
KNOWLEDGE_VECTOR_CANDIDATE_LIMIT=20
KNOWLEDGE_RRF_K=60
KNOWLEDGE_MAX_HITS_PER_DOCUMENT=2
KNOWLEDGE_EVALUATION_OUTPUT_DIR=.eval-runs/knowledge

# --- Embedding provider (INDEPENDENT of the chat LLM above) -------------------
# "unconfigured" (default) is the honest default: without a real provider there is
# no vector retrieval, and the system says so instead of substituting fake vectors.
# LEXICAL_ONLY retrieval keeps working. `doctor` reports DEGRADED, never READY.
# Do NOT point this at the chat endpoint: a chat model is not an embedding model.
EMBEDDING_PROVIDER=unconfigured
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=0
# NAME of the environment variable holding the key — the VALUE never lives here.
# doctor reports only whether it is present, never its contents.
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_NORMALIZATION=NONE
EMBEDDING_DISTANCE_METRIC=COSINE
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2
