# Copilot domain persistence (copilot schema — Alembic-owned)
COPILOT_DATABASE_URL=postgresql+psycopg://copilot:copilot@127.0.0.1:5432/copilot

# LangGraph checkpoint persistence (langgraph_checkpoint schema — LangGraph-owned)
# The options=-csearch_path parameter pins the checkpointer to its own schema.
LANGGRAPH_DATABASE_URL=postgresql+psycopg://copilot:copilot@127.0.0.1:5432/copilot?options=-csearch_path%3Dlanggraph_checkpoint
LANGGRAPH_SCHEMA=langgraph_checkpoint

# HISIEM platform read access
HISIEM_BASE_URL=http://127.0.0.1:8080
HISIEM_BEARER_TOKEN=
HISIEM_TIMEOUT_SECONDS=10.0

# LLM provider (V1: null provider — no real calls yet)
LLM_PROVIDER=null
LLM_MODEL=gpt-4o-mini

# Agent autonomy budget
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_TOOL_CALLS_PER_STEP=4
AGENT_MAX_LLM_TOKENS=20000
AGENT_MAX_DURATION_SECONDS=600

# API transport
COPILOT_APP_API_HOST=0.0.0.0
COPILOT_APP_API_PORT=8000

# Trusted-context provider: "none" (default, fail closed) or "header" (dev/test only).
# Production MUST NOT use "header" — wire a real authenticator instead.
COPILOT_AUTH_TRUSTED_CONTEXT_PROVIDER=none
